{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reality-check ticket frontmatter (mirrored in tickets/tickets.jsonl)",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "severity",
    "gap",
    "surface",
    "sources",
    "status",
    "created_run",
    "file",
    "acceptance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TKT-[0-9]{3,}$"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "functional",
        "visual",
        "ux",
        "a11y",
        "copy",
        "console-error",
        "performance"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "gap": {
      "type": "string",
      "enum": [
        "model-belief",
        "behavior",
        "unnarrated",
        "design",
        "promise",
        "environment"
      ]
    },
    "surface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^((clm|obs|dsg)-[a-z0-9-]+-[0-9]+|exp-[0-9]+)$"
      }
    },
    "suspected_source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screenshot": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "description": "agent-browser commands; the last item states the exact expected output"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "fixed",
        "reopened",
        "wontfix",
        "superseded"
      ]
    },
    "created_run": {
      "type": "string"
    },
    "fixed_run": {
      "type": "string"
    },
    "wontfix_reason": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}