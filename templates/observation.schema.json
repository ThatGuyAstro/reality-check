{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reality-check unnarrated observation (observations.jsonl)",
  "type": "object",
  "required": [
    "id",
    "surface",
    "run_id",
    "observed",
    "expected_by_a_human",
    "screenshot",
    "severity",
    "gap",
    "status",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^obs-[a-z0-9-]+-[0-9]+$"
    },
    "surface": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "observed": {
      "type": "string"
    },
    "expected_by_a_human": {
      "type": "string"
    },
    "screenshot": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "hidden-control",
        "confirmed-no-effect",
        "pointer-click-flaky",
        "human-eye",
        "state-gap",
        "transformation"
      ]
    },
    "related_claim": {
      "type": "string"
    },
    "gap": {
      "type": "string",
      "const": "unnarrated"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ]
    }
  }
}